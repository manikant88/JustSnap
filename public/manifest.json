{
  "manifest_version": 3,
  "minimum_chrome_version": "150",
  "name": "Docksnip",
  "version": "0.1.3",
  "description": "Capture screenshots and images in a local visual dock, organize them into folders, and drag copies into compatible destinations.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "storage", "scripting", "clipboardWrite", "unlimitedStorage", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open Docksnip",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "commands": {
    "toggle-justsnap": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Docksnip"
    },
    "start-capture": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Start a Docksnip capture"
    },
    "close-justsnap": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Close Docksnip"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/HostGrotesk-Variable.woff2",
        "logos/docksnip-logomark.svg"
      ],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "options.html"
}
